[user]
	email = $email
	name = $name
[color]
	diff = auto
	status = auto
	branch = auto
[core]
	autocrlf = input
	excludesfile=$path
	trustctime = false
[alias]
    # Commits
    cap     = "!f() { git add . && git commit -m \"$1\" && git push; }; f"
    undo    = reset --soft HEAD~1
    amend   = commit --amend --no-edit
    amendm  = commit --amend
    # Push
    pf      = push origin HEAD --force
    # Branches
    new     = checkout -b
    branches = branch -v
    wipe    = !git branch | grep -v "\\*" | xargs git branch -D
    gone    = !git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
    # Diff
    ds      = diff --staged
    dm = !git diff $(git merge-base HEAD $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'))..HEAD
    # Logs
    gr      = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset:%an' --abbrev-commit --date=relative  
	grall   = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset:%an' --abbrev-commit --date=relative --all 
	gralt   = log --date=iso --pretty=format:\"%h %ad %an %s\" --graph --topo-order --all 
    last    = log -1 HEAD --stat
    today   = log --oneline --since="midnight" --author="$(git config user.name)"
    # Search
    find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
    show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"
    # Stash
    ss      = stash save
    sl      = stash list
    sp      = stash pop
    sd      = stash drop
    # Synchronization
    sync    = !git fetch origin && git rebase origin/$(git symbolic-ref --short HEAD)
    # Utilities
    aliases = config --get-regexp alias
[apply]
	whitespace = nowarn
[merge]
	tool = kdiff3
[diff]
	renamelimit = 2048
[rerere]
	enabled =false 
[mergetool]
	trustExitCode = true